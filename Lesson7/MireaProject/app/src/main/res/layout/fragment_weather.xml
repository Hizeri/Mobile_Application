<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Погода в Москве"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/buttonLoadWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Получить погоду"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/textViewWeatherStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Статус: ожидание"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textViewTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Температура:"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/textViewWindSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Скорость ветра:"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/textViewWindDirection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Направление ветра:"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>